# Keep the Docker build context small and reproducible. node_modules is
# re-installed inside the image (the committed lockfile keeps win32 native
# binaries; the image installs the linux ones — see Dockerfile base stage).
node_modules
**/node_modules
**/dist
**/dist/public
**/out-tsc
*.tsbuildinfo

# Local env / secrets — real values come from a `.env` next to docker-compose.yml
# (auto-loaded by Compose) or the `${VAR:-default}` placeholders in the compose file.
.env
**/.env
.env.local
**/.env.local

# Git + CI + editor/OS noise
.git
.github
.idea
.vscode
**/.idea
.DS_Store
Thumbs.db

# Replit + local dev scaffolding not needed in a Linux image
.replit
.replitignore
.local/
.claude/
.cache/

# Docker artifacts themselves
Dockerfile
.dockerignore
docker-compose.yml
