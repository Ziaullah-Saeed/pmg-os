# =============================================================================
# PMG Group OS — optional Docker env overrides
# =============================================================================
# The stack runs with ZERO config (AI is in dummy mode by default). To enable
# REAL AI or change secrets, copy this file to `.env` next to docker-compose.yml
# and fill in values — Compose auto-loads `.env` and these override the
# `${VAR:-default}` placeholders in docker-compose.yml.
#
#   cp .env.docker.example .env
# -----------------------------------------------------------------------------

# Session cookie signing secret (any long random string in production).
SESSION_SECRET=pmg-os-dev-secret-change-in-production

# --- AI -----------------------------------------------------------------------
# Leave AI_DUMMY_MODE=true for canned AI responses (no key, no cost).
# Set it to false AND provide a real OpenAI-compatible key to run live AI.
AI_DUMMY_MODE=true
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# --- Apollo lead-gen ----------------------------------------------------------
# Monthly credit cap (match your Apollo plan; the master API key itself is
# entered in the app at Settings -> API Keys, not here).
APOLLO_MONTHLY_CREDIT_CAP=2500

# Async MOBILE reveal (optional). Apollo verifies freshly-revealed mobile numbers
# out-of-band (~8 credits each) and POSTs them to a webhook minutes later. To
# enable, set APOLLO_WEBHOOK_URL to a PUBLICLY reachable URL that resolves to this
# API's `POST /api/apollo/phone-webhook`. Apollo cannot reach localhost — in dev
# use a tunnel (e.g. `ngrok http 8080` or `cloudflared`), in prod your real host.
# APOLLO_WEBHOOK_SECRET is appended as `?secret=` and verified on the way in.
# Leave APOLLO_WEBHOOK_URL blank to keep phone capture sync-only (already-known
# numbers only, no async mobile reveal).
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_SECRET=
