# =============================================================================
# PMG Group OS — optional Docker env overrides
# =============================================================================
# The stack runs with ZERO config (AI is in dummy mode by default). To enable
# REAL AI or change secrets, copy this file to `.env` next to docker-compose.yml
# and fill in values — Compose auto-loads `.env` and these override the
# `${VAR:-default}` placeholders in docker-compose.yml.
#
#   cp .env.docker.example .env
# -----------------------------------------------------------------------------

# Session cookie signing secret (any long random string in production).
SESSION_SECRET=pmg-os-dev-secret-change-in-production

# --- AI -----------------------------------------------------------------------
# Leave AI_DUMMY_MODE=true for canned AI responses (no key, no cost).
# Set it to false AND provide a real OpenAI-compatible key to run live AI.
AI_DUMMY_MODE=true
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# --- Apollo lead-gen ----------------------------------------------------------
# Monthly credit cap (match your Apollo plan; the master API key itself is
# entered in the app at Settings -> API Keys, not here).
APOLLO_MONTHLY_CREDIT_CAP=2500

# Async MOBILE reveal (optional). Apollo verifies freshly-revealed mobile numbers
# out-of-band (~8 credits each) and POSTs them to a webhook minutes later. To
# enable, set APOLLO_WEBHOOK_URL to a PUBLICLY reachable URL that resolves to this
# API's `POST /api/apollo/phone-webhook`. Apollo cannot reach localhost — in dev
# use a tunnel (e.g. `ngrok http 8080` or `cloudflared`), in prod your real host.
# APOLLO_WEBHOOK_SECRET is appended as `?secret=` and verified on the way in.
# Leave APOLLO_WEBHOOK_URL blank to keep phone capture sync-only (already-known
# numbers only, no async mobile reveal).
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_SECRET=

# --- Social Command — inbound social inbox (Phase 1 + WhatsApp) ---------------
# All blank by default → every receiver stays INERT and shows an honest
# "not connected" state until you fill these in. Meta cannot reach localhost, so
# point your Meta/WhatsApp webhook URLs at a PUBLIC tunnel/host that resolves to
# this API (e.g. `ngrok http 8080`, `cloudflared`, or your prod domain).
#
# Webhook endpoints exposed by this API (all under /api):
#   Facebook Page / Lead Ads:  GET+POST  /api/webhooks/meta
#   WhatsApp Cloud API:        GET+POST  /api/webhooks/whatsapp
#   First-party website form:  POST      /api/webhooks/website-form
# The GET routes answer Meta's subscription handshake (echo hub.challenge when
# hub.verify_token matches). POSTs are HMAC-verified via X-Hub-Signature-256.

# Meta app (Graph API — Facebook Page comments/Lead Ads now; Messenger+IG later).
#   META_APP_SECRET       — your Meta app secret (verifies POST signatures).
#   META_VERIFY_TOKEN     — any string you also paste into the Meta webhook config.
#   META_PAGE_ACCESS_TOKEN— Page token used to FETCH Lead Ad answers (leadgen).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# WhatsApp Business Cloud API. Inbound needs the verify token + app secret;
# outbound (replies from the inbox) needs a permanent access token + the Phone
# Number ID. WHATSAPP_APP_SECRET/WHATSAPP_VERIFY_TOKEN fall back to the META_*
# values above if you use the same Meta app for both.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# First-party website contact form. Optional shared secret — when set, form
# POSTs must include it as ?secret=... (leave blank to accept unauthenticated).
WEBSITE_FORM_SECRET=
